# set global parameters


domain boxdims 256.0 256.0 256.0 boxorigin -128.0 -128.0 -128.0

grid_style 64 64 64 concentration

grid_populate sphere concentration 30.0 10.0 1.0 0.3

# can either use grid_setup to read in old data or create new grid data	

fix grid/laplacephi laplace every
fix grid/gradphi grad every

dump realgrid grid output/field 1 attributes 5 phi laplacephi gradphi_x gradphi_y gradphi_z


timestep 0
dt 1e-4

run 1