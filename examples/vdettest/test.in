# set global parameters


domain boxdims 256.0 256.0 256.0 boxorigin -128.0 -128.0 -128.0

grid_style 128 128 128 modelh

grid_populate sphere modelh 80.0 25.0 0.9 0.5

# can either use grid_setup to read in old data or create new grid data	

fix grid/floryhuggins chempot temp 1.0 chi 1.0 volFH 1.0
fix grid/gradphi grad immediate ftphi

fix grid/vdet vdet 1.0

compute complex vx ft_vdet_x norm
compute complex vy ft_vdet_y norm
compute complex vz ft_vdet_z norm


dump realgrid grid output/field 1 attributes 7 vdet_x vdet_y vdet_z gradphi_x gradphi_y gradphi_z phi
dump fftgrid ftgrid output/ft_field 1 attributes 3 c_vx c_vy c_vz


timestep 0
dt 1e-4

run 1